{
  "name": "AIToolLink",
  "type": "object",
  "properties": {
    "tool_name": {
      "type": "string",
      "description": "Name of the AI tool or GPT"
    },
    "description": {
      "type": "string",
      "description": "Short description of what the tool does"
    },
    "pixels_toolbox_url": {
      "type": "string",
      "description": "Direct URL to the tool (e.g. ChatGPT link)"
    },
    "lets_go_nuts_url": {
      "type": "string",
      "description": "Alternative URL or landing page"
    },
    "icon_url": {
      "type": "string",
      "description": "Icon URL"
    },
    "icon_emoji": {
      "type": "string",
      "description": "Emoji icon"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "string",
      "enum": [
        "custom_gpt",
        "external_tool",
        "resource"
      ],
      "default": "custom_gpt"
    },
    "is_general_tool": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tool_name",
    "pixels_toolbox_url"
  ]
}