{
  "name": "BibleResource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Resource title"
    },
    "description": {
      "type": "string",
      "description": "Short description"
    },
    "link": {
      "type": "string",
      "description": "URL to resource"
    },
    "download_url": {
      "type": "string",
      "description": "Direct download URL"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Cover image URL"
    },
    "category": {
      "type": "string",
      "description": "Category (e.g., Study, Devotional, Kids)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Is visible on the page"
    },
    "is_free": {
      "type": "boolean",
      "default": true,
      "description": "Is this a free resource"
    },
    "sort_order": {
      "type": "number",
      "default": 100,
      "description": "Order on page"
    }
  },
  "required": [
    "title"
  ]
}