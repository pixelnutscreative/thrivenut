{
  "name": "CampaignTypeConfig",
  "type": "object",
  "properties": {
    "type_id": {
      "type": "string",
      "description": "Type ID slug (e.g., tool_promotion)"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "description": {
      "type": "string",
      "description": "Type description"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Default campaign type from blueprint"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Is this type active"
    }
  },
  "required": [
    "type_id",
    "name"
  ]
}