{
  "name": "GroupDiscussionPost",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "poll"
      ],
      "default": "text"
    },
    "media_url": {
      "type": "string"
    },
    "poll_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "group_id",
    "author_email",
    "content"
  ]
}