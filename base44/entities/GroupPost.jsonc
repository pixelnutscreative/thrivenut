{
  "name": "GroupPost",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "HTML or text content"
    },
    "author_email": {
      "type": "string"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "target_levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "If empty, visible to all levels."
    },
    "target_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "If empty, visible to all roles. Options: client, member, virtual-assistant, etc."
    },
    "is_public": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "group_id",
    "content"
  ]
}