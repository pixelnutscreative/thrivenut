{
  "name": "GroupTraining",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "transcript": {
      "type": "string"
    },
    "resource_url": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "pdf",
        "link",
        "video",
        "image",
        "audio",
        "mixed",
        "other",
        "text"
      ],
      "default": "other"
    },
    "category": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "target_levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "group_id",
    "title"
  ]
}