{
  "name": "GroupTrainingCategory",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "Reference to CreatorGroup"
    },
    "title": {
      "type": "string",
      "description": "Category title (e.g. 'Module 1: Basics')"
    },
    "description": {
      "type": "string",
      "description": "Optional description"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "group_id",
    "title"
  ]
}