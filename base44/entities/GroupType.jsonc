{
  "name": "GroupType",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique identifier/slug used in CreatorGroup.type"
    },
    "name": {
      "type": "string",
      "description": "Human friendly name"
    },
    "description": {
      "type": "string",
      "description": "Description of this group type"
    },
    "color": {
      "type": "string",
      "description": "Optional color (hex or tailwind keyword)"
    },
    "badge_class": {
      "type": "string",
      "description": "Tailwind classes for the badge, e.g. bg-purple-100 text-purple-700"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name (optional)"
    },
    "enabled_tabs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "feed",
        "events",
        "qna",
        "resources",
        "training",
        "members",
        "requests"
      ],
      "description": "Tabs/features enabled for this type"
    },
    "default_member_levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "allow_prospect_management": {
      "type": "boolean",
      "default": false,
      "description": "If true, groups of this type can enable prospect management."
    }
  },
  "required": [
    "key",
    "name"
  ]
}