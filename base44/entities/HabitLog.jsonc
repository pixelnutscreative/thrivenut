{
  "name": "HabitLog",
  "type": "object",
  "properties": {
    "habit_id": {
      "type": "string",
      "description": "Reference to the Habit entity"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of completion (YYYY-MM-DD)"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of completion"
    },
    "day_of_week": {
      "type": "string",
      "description": "Day of week string (e.g. Monday)"
    }
  },
  "required": [
    "habit_id",
    "date"
  ]
}