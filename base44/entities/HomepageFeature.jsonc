{
  "name": "HomepageFeature",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Feature title"
    },
    "description": {
      "type": "string",
      "description": "Feature description"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "section": {
      "type": "string",
      "enum": [
        "free",
        "neurodivergent",
        "premium",
        "customization"
      ],
      "default": "free",
      "description": "Which section on the homepage this belongs to"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "color": {
      "type": "string",
      "description": "Gradient colors (e.g. 'from-purple-500 to-indigo-500')"
    }
  },
  "required": [
    "title",
    "section"
  ]
}