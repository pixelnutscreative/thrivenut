{
  "name": "LiveReminderSignup",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email for live reminders"
    },
    "phone": {
      "type": "string",
      "description": "Phone number for text reminders"
    },
    "prefer_text": {
      "type": "boolean",
      "default": false,
      "description": "Prefers text over email"
    },
    "prefer_email": {
      "type": "boolean",
      "default": true,
      "description": "Prefers email reminders"
    }
  },
  "required": []
}