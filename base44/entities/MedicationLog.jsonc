{
  "name": "MedicationLog",
  "type": "object",
  "properties": {
    "medication_id": {
      "type": "string",
      "description": "Reference to the medication"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the log"
    },
    "doses_taken": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [],
      "description": "Which dose numbers were taken (1, 2, 3 for multi-dose)"
    }
  },
  "required": [
    "medication_id",
    "date"
  ]
}