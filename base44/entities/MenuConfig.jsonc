{
  "name": "MenuConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the menu item"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide-react"
    },
    "path": {
      "type": "string",
      "description": "Internal page path (e.g., 'Dashboard')"
    },
    "external_url": {
      "type": "string",
      "description": "External URL (opens in new tab)"
    },
    "parent_section": {
      "type": "string",
      "description": "Parent section name if this is a sub-item"
    },
    "is_section": {
      "type": "boolean",
      "default": false,
      "description": "Is this a collapsible section?"
    },
    "is_group_header": {
      "type": "boolean",
      "default": false,
      "description": "Is this a colored group header (like Faith & Purpose)"
    },
    "header_color": {
      "type": "string",
      "description": "Text color class for group headers (e.g., text-purple-400)"
    },
    "header_bg_color": {
      "type": "string",
      "description": "Background color class for group headers (e.g., bg-purple-500/10)"
    },
    "module_id": {
      "type": "string",
      "description": "Module ID for feature toggling"
    },
    "requires_tiktok_access": {
      "type": "boolean",
      "default": false
    },
    "requires_bible_believer": {
      "type": "boolean",
      "default": false
    },
    "admin_only": {
      "type": "boolean",
      "default": false
    },
    "always_show": {
      "type": "boolean",
      "default": false
    },
    "show_when_no_tiktok_access": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 100,
      "description": "Order in the menu"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "highlight": {
      "type": "boolean",
      "default": false,
      "description": "Highlight this item in the menu"
    }
  },
  "required": [
    "name"
  ]
}