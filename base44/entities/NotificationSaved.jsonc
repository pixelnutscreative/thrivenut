{
  "name": "NotificationSaved",
  "type": "object",
  "properties": {
    "notification_id": {
      "type": "string",
      "description": "Notification ID"
    },
    "user_email": {
      "type": "string",
      "description": "User who saved it"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was saved"
    }
  },
  "required": [
    "notification_id",
    "user_email"
  ]
}