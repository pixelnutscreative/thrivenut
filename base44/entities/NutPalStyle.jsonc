{
  "name": "NutPalStyle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "prompt_template": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "animal",
        "object",
        "food",
        "abstract",
        "other"
      ],
      "default": "other"
    },
    "soundcloud_url": {
      "type": "string",
      "description": "URL of the song to play for this NutPal style"
    }
  },
  "required": [
    "name"
  ]
}