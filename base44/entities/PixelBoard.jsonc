{
  "name": "PixelBoard",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "asked_by": {
      "type": "string",
      "enum": [
        "Nikole",
        "Pixel Poster"
      ],
      "default": "Nikole"
    },
    "question_type": {
      "type": "string",
      "default": "Question"
    },
    "answer_type": {
      "type": "string",
      "default": "Text"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "nikole_response": {
      "type": "string"
    },
    "pixel_response": {
      "type": "string"
    },
    "nikole_attachment_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "Unanswered"
    },
    "priority": {
      "type": "string",
      "default": "Normal"
    },
    "nikole_read": {
      "type": "boolean",
      "default": false
    },
    "pixel_read": {
      "type": "boolean",
      "default": false
    },
    "batch_ready": {
      "type": "boolean",
      "default": false
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ]
}