{
  "name": "PixelNut",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "nickname": {
      "type": "string",
      "description": "Nickname or alias"
    },
    "role": {
      "type": "string",
      "description": "Role in the team (e.g., Designer, Mod, Creator)"
    },
    "category": {
      "type": "string",
      "enum": [
        "staff",
        "consultant",
        "seed",
        "other"
      ],
      "default": "other",
      "description": "Category of team member"
    },
    "bio": {
      "type": "string",
      "description": "Short bio or description"
    },
    "contribution": {
      "type": "string",
      "description": "What they do for Pixel Nuts Creative"
    },
    "specialty": {
      "type": "string",
      "description": "Their specialty or area of expertise"
    },
    "image_url": {
      "type": "string",
      "description": "Profile image URL"
    },
    "tiktok_username": {
      "type": "string",
      "description": "TikTok username"
    },
    "superpower": {
      "type": "string",
      "description": "Special skill or superpower"
    },
    "fun_fact": {
      "type": "string",
      "description": "A fun fact about them"
    },
    "favorite_emoji": {
      "type": "string",
      "description": "Their favorite emoji"
    },
    "card_color": {
      "type": "string",
      "default": "#bd84f5",
      "description": "Card accent color"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured team member"
    },
    "sort_order": {
      "type": "number",
      "default": 100,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}