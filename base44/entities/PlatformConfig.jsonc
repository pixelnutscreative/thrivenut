{
  "name": "PlatformConfig",
  "type": "object",
  "properties": {
    "platform_id": {
      "type": "string",
      "description": "Platform ID (e.g., TikTok, YouTube, or 'global_announcements')"
    },
    "display_label": {
      "type": "string",
      "description": "Display label"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Is this platform enabled"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "icon": {
      "type": "string",
      "description": "Platform icon or emoji"
    }
  },
  "required": [
    "platform_id",
    "display_label"
  ]
}