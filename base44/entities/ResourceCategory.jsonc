{
  "name": "ResourceCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "sort_order": {
      "type": "number",
      "default": 100,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Show this category"
    }
  },
  "required": [
    "name"
  ]
}