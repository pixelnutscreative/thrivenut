{
  "name": "ShopItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product/service name"
    },
    "description": {
      "type": "string",
      "description": "What this item is"
    },
    "category": {
      "type": "string",
      "enum": [
        "live_stream",
        "fan_stickers",
        "greenscreens",
        "battle_posters",
        "pipsqueeks",
        "digital_twins",
        "nutpals",
        "consultation",
        "other"
      ],
      "description": "Product category"
    },
    "price_description": {
      "type": "string",
      "description": "Price or 'Starting at $X' text"
    },
    "shop_url": {
      "type": "string",
      "description": "Link to purchase"
    },
    "booking_url": {
      "type": "string",
      "description": "Link to book a session"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Example images to show"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Show prominently"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Currently available"
    },
    "sort_order": {
      "type": "number",
      "default": 100,
      "description": "Display order"
    },
    "badge": {
      "type": "string",
      "description": "Special badge like 'New' or 'Popular'"
    }
  },
  "required": [
    "name",
    "category"
  ]
}