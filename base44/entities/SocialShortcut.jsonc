{
  "name": "SocialShortcut",
  "type": "object",
  "properties": {
    "network_id": {
      "type": "string",
      "description": "Network this shortcut belongs to"
    },
    "title": {
      "type": "string",
      "description": "Shortcut title"
    },
    "subtitle": {
      "type": "string",
      "description": "Shortcut subtitle/description"
    },
    "url": {
      "type": "string",
      "description": "Final URL (with handle replaced)"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_hidden": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "network_id",
    "title",
    "url"
  ]
}