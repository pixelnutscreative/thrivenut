{
  "name": "SuperFanRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user requesting access"
    },
    "tiktok_username": {
      "type": "string",
      "description": "User's TikTok username"
    },
    "screenshot_url": {
      "type": "string",
      "description": "URL of uploaded SuperFan screenshot"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "default": "pending",
      "description": "Approval status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes from admin about the request"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was reviewed"
    }
  },
  "required": [
    "user_email",
    "screenshot_url"
  ]
}