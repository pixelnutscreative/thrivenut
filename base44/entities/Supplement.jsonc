{
  "name": "Supplement",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the supplement or vitamin"
    },
    "dosage": {
      "type": "string",
      "description": "User-entered dosage (e.g., '500mg', '2 capsules')"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "once_daily",
        "twice_daily",
        "three_times_daily",
        "as_needed",
        "weekly"
      ],
      "default": "once_daily",
      "description": "How often to take the supplement"
    },
    "time_category": {
      "type": "string",
      "enum": [
        "upon_awakening",
        "with_breakfast",
        "morning_snack",
        "30_min_before_lunch",
        "with_lunch",
        "afternoon_snack",
        "with_dinner",
        "before_bed",
        "empty_stomach_morning",
        "empty_stomach_evening",
        "other"
      ],
      "default": "with_breakfast",
      "description": "When to take the supplement"
    },
    "other_time_category": {
      "type": "string",
      "description": "Custom timing if 'other' is selected"
    },
    "notes": {
      "type": "string",
      "description": "User notes about effects, positive or negative"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this supplement is currently being taken"
    },
    "label_image_url": {
      "type": "string",
      "description": "URL of uploaded supplement label image"
    }
  },
  "required": [
    "name",
    "dosage"
  ]
}