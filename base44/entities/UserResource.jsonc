{
  "name": "UserResource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "Website",
        "Spreadsheet",
        "App",
        "Tool",
        "Client",
        "Project",
        "Doc",
        "Other"
      ],
      "default": "Other"
    },
    "category": {
      "type": "string",
      "default": "Uncategorized"
    },
    "subcategory": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_hot_button": {
      "type": "boolean",
      "default": false
    },
    "hot_button_label": {
      "type": "string"
    },
    "hot_button_icon": {
      "type": "string",
      "default": "\ud83d\udd25"
    },
    "hot_button_order": {
      "type": "number",
      "default": 0
    },
    "color": {
      "type": "string"
    },
    "last_opened": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "url"
  ]
}